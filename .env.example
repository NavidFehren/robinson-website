# EmailJS Configuration
# Get these values from your EmailJS dashboard: https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# PostHog Analytics
# Public project API key from PostHog > Settings > Project (safe to expose client-side)
VITE_POSTHOG_KEY=phc_your_project_key
# Optional: ingest host. Defaults to EU cloud. Use https://us.i.posthog.com for US cloud.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
